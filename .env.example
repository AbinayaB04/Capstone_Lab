# Add your Google Gemini API key here
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection String
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0"

# Groq API Key for advanced language models
GROQ_API_KEY=your_groq_api_key_here

# API Base URL (For Docker networking, typically http://backend:8000 internally or localhost:8002 externally)
API_BASE_URL=http://backend:8000

# (Optional) JWT Secret for IAM token generation
JWT_SECRET=super-secret-capstone-key-2026
